generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  SINGLE_CHOICE
  MATCHING
}

model Question {
  id              String       @id @default(cuid())
  questionText    String
  questionTextZh  String?
  options         String[]
  optionsZh       String[]
  correctAnswer   String
  questionType    QuestionType @default(SINGLE_CHOICE)
  matchItems      String[]     @default([])
  matchItemsZh    String[]     @default([])
  explanation     String
  explanationZh   String?
  domain          Domain
  difficulty      Difficulty
  questionImages  String[] @default([])
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  examAnswers     ExamAnswer[]
  mindMapNodes    MindMapNode[]
}

model Note {
  id          String   @id @default(cuid())
  title       String
  titleZh     String?
  content     String
  contentZh   String?
  domain      Domain
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Flashcard {
  id          String   @id @default(cuid())
  front       String
  frontZh     String?
  back        String
  backZh      String?
  domain      Domain
  nextReview  DateTime @default(now())
  interval    Int      @default(0)
  easeFactor  Float    @default(2.5)
  repetitions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mindMapNodes MindMapNode[]
}

model Progress {
  id                    String   @id @default(cuid())
  domain                Domain   @unique
  quizQuestionsAnswered Int      @default(0)
  examQuestionsAnswered Int      @default(0)
  quizCorrectCount      Int      @default(0)
  examCorrectCount      Int      @default(0)
  lastStudied           DateTime @default(now())
}

model ExamAttempt {
  id          String      @id @default(cuid())
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  score       Int?
  timeSpent   Int?
  answers     ExamAnswer[]
}

model ExamAnswer {
  id            String      @id @default(cuid())
  attemptId     String
  questionId    String
  selectedAnswer String
  isCorrect     Boolean
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id])
  question      Question    @relation(fields: [questionId], references: [id])
}

enum Domain {
  SECURITY_RISK_MANAGEMENT
  ASSET_SECURITY
  SECURITY_ARCHITECTURE
  COMMUNICATION_NETWORK_SECURITY
  IDENTITY_ACCESS_MANAGEMENT
  SECURITY_ASSESSMENT
  SECURITY_OPERATIONS
  SOFTWARE_DEVELOPMENT_SECURITY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model MindMap {
  id        String   @id @default(cuid())
  domain    Domain   @unique
  nodes     MindMapNode[]
  edges     MindMapEdge[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MindMapNode {
  id                String    @id @default(cuid())
  mindMapId         String
  label             String
  labelZh           String?
  description       String?
  descriptionZh     String?
  positionX         Float
  positionY         Float
  color             String?
  linkedFlashcardId String?
  linkedQuestionId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  mindMap     MindMap    @relation(fields: [mindMapId], references: [id], onDelete: Cascade)
  flashcard   Flashcard? @relation(fields: [linkedFlashcardId], references: [id], onDelete: SetNull)
  question    Question?  @relation(fields: [linkedQuestionId], references: [id], onDelete: SetNull)
  sourceEdges MindMapEdge[] @relation("SourceNode")
  targetEdges MindMapEdge[] @relation("TargetNode")
}

model MindMapEdge {
  id           String  @id @default(cuid())
  mindMapId    String
  sourceNodeId String
  targetNodeId String
  label        String?
  labelZh      String?
  createdAt    DateTime @default(now())

  mindMap    MindMap      @relation(fields: [mindMapId], references: [id], onDelete: Cascade)
  sourceNode MindMapNode  @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode MindMapNode  @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([mindMapId, sourceNodeId, targetNodeId])
}
